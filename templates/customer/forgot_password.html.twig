{% extends 'bootstrap/base.html.twig' %}

{% block title %}{{ 'password_reset.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 440px">
        <h1 class="h3 mb-2">{{ 'password_reset.title'|trans }}</h1>
        <p class="text-body-secondary">{{ 'password_reset.intro'|trans }}</p>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-validate': ''}}) }}
                    {{ form_row(form.email) }}
                    <button class="btn btn-primary w-100" type="submit" data-busy-on-submit>{{ 'password_reset.send'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>
        <p class="text-center mt-3"><a href="{{ path('customer_login') }}">{{ 'password_reset.back'|trans }}</a></p>
    </div>
{% endblock %}
