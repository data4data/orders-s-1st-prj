{% extends 'bootstrap/base.html.twig' %}

{% block title %}{{ 'password_reset.new_title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 440px">
        <h1 class="h3 mb-3">{{ 'password_reset.new_title'|trans }}</h1>
        {% if form %}
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-validate': ''}}) }}
                        {{ form_row(form.password) }}
                        {{ form_row(form.repeatPassword) }}
                        <button class="btn btn-primary w-100" type="submit" data-busy-on-submit>{{ 'password_reset.save'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            </div>
        {% else %}
            <div class="alert alert-warning d-flex gap-2" role="alert">{{ icon('warning') }}<div>{{ 'password_reset.expired'|trans }}</div></div>
            <a class="btn btn-primary" href="{{ path('customer_forgot_password') }}">{{ 'password_reset.request_new'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}
