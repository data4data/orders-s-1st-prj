{% extends 'vue/base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    {# Server-rendered heading for search engines and no-JS; the Vue island replaces it. #}
    <div data-vue-page="Product" data-props="{{ props|json_encode }}">
        <div class="mx-auto max-w-6xl px-4 py-6"><h1 class="text-2xl font-bold">{{ product.name }}</h1><p>{{ product.description }}</p></div>
    </div>
{% endblock %}
