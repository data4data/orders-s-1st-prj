{# Shell for the admin SPA on admin.shop.test. Loads ONLY the "admin" entry (no Bootstrap). Neutral platform colours. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="csrf-token" content="{{ csrf_token('api') }}">
        <title>{{ 'admin.title'|trans }} · MyOil's</title>
        <link rel="icon" href="/favicon.svg">
        {{ brand_style() }}
        {{ vite_entry_link_tags('admin') }}
        {{ vite_entry_script_tags('admin') }}
    </head>
    <body class="bg-surface-50 text-surface-900">
        <div id="admin-app" data-props="{{ {
            user: {email: app.user.email, firstName: app.user.firstName, lastName: app.user.lastName, superAdmin: app.user.superAdmin},
            devTools: app.environment == 'dev'
        }|json_encode }}"></div>
    </body>
</html>
