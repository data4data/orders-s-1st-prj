{#
 # One branded error page for every status (docs/diagrams/pages.html → Error handling).
 # Store hosts use the store's branding; unknown hosts get the neutral "Store not found" page.
 # In dev, preview with /_error/404, /_error/419, /_error/429, /_error/500, /_error/503 …
 #}
{% extends 'bootstrap/base.html.twig' %}
{% set layout = storefront_layout() %}
{% set is_admin_host = app.request.host starts with 'admin.' %}
{% set key = status_code in [403, 404, 419, 429, 500, 503] ? status_code : (status_code >= 500 ? 'generic_5xx' : 'generic_4xx') %}
{% if status_code == 404 and layout is null and not is_admin_host %}{% set key = 'store_not_found' %}{% endif %}
{% set retry_after = exception is defined and exception.headers['Retry-After'] is defined ? exception.headers['Retry-After'] : null %}

{% block title %}{{ ('errors.' ~ key ~ '.title')|trans }}{% endblock %}

{% block body %}
    <section class="container py-5 text-center error-page">
        <div class="display-3 fw-bold text-primary">{{ key == 'store_not_found' ? icon('store') : status_code }}</div>
        <h1 class="h3 mt-3">{{ ('errors.' ~ key ~ '.title')|trans }}</h1>
        <p class="text-body-secondary mx-auto" style="max-width: 36rem">{{ ('errors.' ~ key ~ '.text')|trans }}</p>
        {% if status_code == 429 and retry_after %}
            <p class="fw-semibold">{{ 'errors.429.countdown'|trans({'%seconds%': retry_after})|raw }}</p>
        {% endif %}
        {% if status_code >= 500 and request_reference() %}
            <p class="small text-body-secondary">{{ 'errors.reference'|trans({'%code%': request_reference()}) }}</p>
        {% endif %}
        <div class="d-flex justify-content-center gap-2 mt-4">
            {% if status_code in [419, 429, 500, 502, 503, 504] %}
                <a class="btn btn-primary" href="{{ app.request.uri }}">{{ icon('refresh') }} {{ 'errors.try_again'|trans }}</a>
            {% endif %}
            {% if is_admin_host %}
                <a class="btn btn-outline-secondary" href="/">{{ icon('home') }} {{ 'errors.back_home'|trans }}</a>
            {% elseif layout %}
                <a class="btn {{ status_code in [419, 429, 500, 502, 503, 504] ? 'btn-outline-secondary' : 'btn-primary' }}" href="/">{{ icon('home') }} {{ 'errors.back_home'|trans }}</a>
            {% endif %}
        </div>
    </section>
{% endblock %}
