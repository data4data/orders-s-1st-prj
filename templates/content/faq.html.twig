{% extends 'content/_page.html.twig' %}

{% block title %}{{ 'content.faq.title'|trans }}{% endblock %}
{% block heading %}{{ 'content.faq.title'|trans }}{% endblock %}

{% block content %}
    {% for group, questions in {ordering: ['account', 'vat', 'change'], delivery: ['when', 'countries', 'free'], products: ['which', 'sds', 'drums'], payment: ['methods', 'failed', 'refund']} %}
        <h2 class="h5 mt-4">{{ ('content.faq.group.' ~ group)|trans }}</h2>
        <div class="accordion" id="faq-{{ group }}">
            {% for q in questions %}
                {% set id = 'faq-' ~ group ~ '-' ~ q %}
                <div class="accordion-item">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ id }}" aria-expanded="false" aria-controls="{{ id }}">{{ ('content.faq.' ~ group ~ '.' ~ q ~ '.q')|trans }}</button>
                    </h3>
                    <div id="{{ id }}" class="accordion-collapse collapse" data-bs-parent="#faq-{{ group }}">
                        <div class="accordion-body">{{ ('content.faq.' ~ group ~ '.' ~ q ~ '.a')|trans({'%store%': layout.store.name}) }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
    <p class="mt-4">{{ 'content.faq.more'|trans }} <a href="/contact">{{ 'content.faq.contact'|trans }}</a></p>
{% endblock %}
