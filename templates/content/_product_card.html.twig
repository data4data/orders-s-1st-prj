{# Product card for Bootstrap pages; the Vue twin is assets/vue/catalog/ProductCard.vue. #}
<a class="card h-100 text-decoration-none text-body shadow-sm product-card" href="/p/{{ product.slug }}">
    {% if product.imageUrl %}<img class="card-img-top" src="{{ product.imageUrl }}" alt="{{ product.imageAlt ?? product.name }}" loading="lazy">{% endif %}
    <div class="card-body d-flex flex-column gap-1">
        <div class="fw-semibold">{{ product.name }}</div>
        <div class="d-flex flex-wrap gap-1">{% for badge in product.badges %}<span class="badge text-bg-light border">{{ badge }}</span>{% endfor %}</div>
        {% if product.fromPrice %}
            <div class="mt-auto">
                <span class="fs-5 fw-bold">{{ (product.multiplePacks ? 'content.from' : 'content.price')|trans({'%price%': product.fromPrice.gross|money(product.fromPrice.currency)}) }}</span>
                <span class="small text-body-secondary">{{ 'content.incl_vat'|trans }}</span>
                {% if product.fromPrice.perLitre %}<div class="small text-body-secondary">{{ 'content.per_litre'|trans({'%price%': product.fromPrice.perLitre|money(product.fromPrice.currency)}) }}</div>{% endif %}
            </div>
        {% endif %}
    </div>
</a>
