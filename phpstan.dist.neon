parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
        # Tenant entities keep `store` null until TenantAssignListener stamps the active store
        # on prePersist, although the store_id column is NOT NULL.
        allowNullablePropertyForRequiredField: true
